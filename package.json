{
  "name": "2048-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@2048/web",
    "dev:ext": "npm run dev --workspace=@2048/extension",
    "build:web": "npm run build --workspace=@2048/web",
    "build:ext": "npm run build --workspace=@2048/extension",
    "build:favicons": "node scripts/build-favicons.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run packages/core"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
